{
  "schemaVersion": 1,
  "id": "express",
  "ruleVersion": 1,
  "rules": [
    {
      "id": "project",
      "match": {
        "files": [
          "**/package.json"
        ],
        "dependenciesAny": [
          "express"
        ]
      },
      "resolve": "package-metadata-v1",
      "emit": {
        "frameworks": [
          "express"
        ]
      }
    }
  ]
}
